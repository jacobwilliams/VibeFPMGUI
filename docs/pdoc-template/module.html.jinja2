{#- pdoc's module page, with one change: the sidebar's "API Documentation"
    heading is only shown when the module has public members to list under it.
    (pdoc checks for any members, so a package whose only members are private,
    like vibefpmgui's __version__, got the heading with nothing under it.) -#}
{% extends "default/module.html.jinja2" %}
{% block nav_members %}
    {% set listed = namespace(any=false) %}
    {% for m in module.members.values() if is_public(m) | trim %}
        {% set listed.any = true %}
    {% endfor %}
    {% if listed.any %}
        <h2>API Documentation</h2>
        {{ nav_members(module.members.values()) }}
    {% endif %}
{% endblock %}
